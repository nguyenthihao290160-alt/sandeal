# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
/build
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local data storage (tokens, products, etc.)
.data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Isolated test storage and Node compile caches generated by local validation.
/.test-tmp/
/.wrangler/
**/.wrangler/
.dev.vars*

# Local continuation notes; never include session handoff state in a release.
/.handoff/

# local release artifacts and verified backups
/.release/
/.backups/
/.sandeal-build-manifest.json
.idea/*.xml~

# Local databases and transaction sidecars
*.sqlite
*.sqlite3
*.db
*.sqlite-*
*.sqlite3-*
*.db-*

# Runtime logs and tool caches
*.log
*.log.*
.cache/
.turbo/
.eslintcache

# Temporary files and local migration output
/tmp/
/temp/
/migration-output/
.tmp/
*.tmp
*.tmp.*
*.swp
*.swo
*~
desktop.ini

# Browser profiles, authentication state, and disposable test reports
.auth/
/browser-profile/
/storageState*.json
/storage-state*.json
/cookies*.json
/cookies*.txt
playwright-report/
test-results/

# Local credentials; keep shared source configuration tracked
*.key
*.p12
*.pfx
/service-account*.json
/service_account*.json
/credentials.json
/auth.json
/.codex/auth.json*
/.codex/sessions/
/.codex/log/

# IDE-local deployment connections, not shared project settings
/.idea/deployment.xml
/.idea/webServers.xml
