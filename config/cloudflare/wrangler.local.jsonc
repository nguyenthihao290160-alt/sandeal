{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sandeal-storage-local-only",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  // No Worker entrypoint, account, zone, route, or deploy script.
  // This UUID is a local placeholder, NOT a Cloudflare resource identifier.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sandeal-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../src/lib/storage/d1/migrations",
    "remote": false
  }],
  "env": { "production": { "d1_databases": [] } }
}
